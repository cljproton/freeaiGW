# 必填：由 docker-entrypoint.sh 首次启动时自动生成，无需手动填写
# ENCRYPTION_KEY=
# CRON_TOKEN=

# 数据目录（相对容器内工作目录 /app）
DATA_DIR=./data

# 监听端口与主机；HOST=0.0.0.0 才对外可访问
PORT=8791
HOST=0.0.0.0

# 每日 Cron 调度（cron 表达式，UTC）
CRON_SCHEDULE=0 3 * * *

# 可选：Google AdSense（均非空才注入广告单元）
# ADSENSE_CLIENT=
# ADSENSE_SLOT=

# 可选：SEO 统一基址（canonical/OG/sitemap；空则按请求 Host 推导）
# PUBLIC_BASE_URL=https://freeai-gateway.example.com

# 可选：GHCR 镜像仓库与标签（默认官方公开镜像，无需自建）
# GHCR_REPO=ghcr.io/cljproton/freeaigw
# IMAGE_TAG=latest